NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# Server-only, read at run time. This server's own calls to the API (pages,
# the proxy's custom-domain lookup, the dashboard preview) take this address
# instead, e.g. the backend's Railway private address. If it can't be reached
# a call is sent once more to NEXT_PUBLIC_API_BASE_URL. Unset: the public
# address only, as before. The browser always uses NEXT_PUBLIC_API_BASE_URL.
# INTERNAL_API_BASE_URL=http://backend.railway.internal:4000/api/v1
# Server-only: no NEXT_PUBLIC_ prefix, so it never reaches the browser. Same
# value as the API's STOREFRONT_PROXY_SECRET; lets server-rendered pages pass
# each shopper's IP to the API's rate limiter.
STOREFRONT_PROXY_SECRET=

# Root domain each store's subdomain hangs off: `<slug>.zimos.co`. Also decides
# where a request with no store in its host is redirected. Override for a
# staging domain; leave unset to use the production default.
NEXT_PUBLIC_ROOT_DOMAIN=zimos.co

# Server-only. Merchant-owned domains (shop.example.com): the proxy asks the API
# which store a host belongs to. Off unless exactly "true"; off, the proxy never
# looks a host up and routes exactly as before.
CUSTOM_DOMAINS_ENABLED=false

# Build-time. Sites allowed to show the store inside a frame, besides the store
# itself: comma-separated origins, never a wildcard. The dashboard's live
# previews frame the store, so list the dashboard's origin. Unset sends no
# header and any site may frame the store, as before.
STOREFRONT_FRAME_ANCESTORS=

# Build-time. The hero slider's newer settings: the text's place on a phone, the
# veil over the picture, a background video. Off unless exactly "true"; off, a
# slide is drawn exactly as before. Pairs with the dashboard's VITE_HERO_MEDIA_ENABLED.
NEXT_PUBLIC_HERO_MEDIA_ENABLED=false

# Build-time. The store's side columns: on the products page, the filters in
# use as chips, the sort inside the filter column and a bottom sheet with
# "Apply" on a phone; store-wide, the side navigation a store can pick in its
# look. Off unless exactly "true"; off, every store is drawn exactly as before.
# Pairs with the dashboard's VITE_STORE_SIDEBAR_ENABLED, which offers the choice.
NEXT_PUBLIC_STORE_SIDEBAR_ENABLED=false

# Server-only, read at run time. Lets Cloudflare keep a store's public pages
# (home, catalogue, product, policies, the merchant's own pages) for anonymous
# visitors: they answer `public, max-age=0, s-maxage=<S_MAXAGE>,
# stale-while-revalidate=<SWR>` instead of `private, no-store`. Cart, checkout,
# payment, account, orders, tracking, previews, any visitor with a language or
# light/dark cookie, any redirect, error or Set-Cookie stay private. Off unless
# exactly "true"; off, every response is exactly as before. Needs the Cloudflare
# Cache Rule in docs/edge-cache/README.md to have any effect.
STOREFRONT_EDGE_CACHE_ENABLED=false
# Seconds Cloudflare keeps a page (1–86400, default 60) and may then serve it
# stale while it fetches a fresh one (0–86400, default 300; 0 leaves it out).
# STOREFRONT_EDGE_CACHE_S_MAXAGE=60
# STOREFRONT_EDGE_CACHE_SWR=300
